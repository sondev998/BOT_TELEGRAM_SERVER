# ==========================================
# CẤU HÌNH DUAL AGENT, COCOS PREVIEW & SECURITY TELEGRAM BOT
# ==========================================

# 1. Token Telegram Bot (Lấy từ @BotFather trên Telegram)
TELEGRAM_BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN_HERE

# 2. Telegram User ID của bạn (Bảo mật tầng 1: Danh sách Whitelist)
# Chat với @userinfobot hoặc nhắn tin vào bot để lấy ID.
ALLOWED_USER_IDS=YOUR_TELEGRAM_USER_ID

# 3. Mã PIN Xác thực (Bảo mật tầng 2: scrypt hash)
# Tạo mã hash mới bằng lệnh: python auth_manager.py --set-pin <mã_pin>
AUTH_PIN_HASH=b427faf56f1bb190788d1df72d127997:35c1e065b69f54c463ce1d3e4cf37258e6e9daa79a222d9d75a3a4902a3dac0c244723cf4bbac8638bc27036e2ed172520729300009f6b260bf18031ab458383
AUTH_MAX_ATTEMPTS=5
AUTH_LOCKOUT_SECONDS=300
AUTH_AUTO_LOCK_MINUTES=30

# 4. Agent mặc định khi khởi động: antigravity | codex
DEFAULT_AGENT=antigravity

# 5. Thư mục làm việc mặc định (Default Workspace)
DEFAULT_WORKSPACE=E:\TELEGRAM_BOT\CocosDevBot

# 6. Cấu hình Antigravity Agent:
# Model: Gemini 3.7 Flash (High), Gemini 3.1 Pro (High), Claude Sonnet 4.6 (Thinking), ...
DEFAULT_MODEL=Gemini 3.7 Flash (High)
DEFAULT_EFFORT=high
DEFAULT_MODE=accept-edits
AGY_PATH=C:\Users\admin\AppData\Local\agy\bin\agy.exe

# 7. Cấu hình OpenAI Codex Agent:
# Model: gpt-5.6-terra, o3, o3-mini, gpt-4.1, default (lấy từ ~/.codex/config.toml)
DEFAULT_CODEX_MODEL=gpt-5.6-terra
DEFAULT_CODEX_EFFORT=medium
CODEX_PATH=C:\Users\admin\AppData\Roaming\npm\codex.cmd

# 8. Cấu hình Cocos Creator Engine (để trống để tự động quét C:\ProgramData\cocos\editors\Creator)
# COCOS_CREATOR_2X_PATH=C:\ProgramData\cocos\editors\Creator\2.4.4\CocosCreator.exe
# COCOS_CREATOR_3X_PATH=C:\ProgramData\cocos\editors\Creator\3.8.6\CocosCreator.exe
DEFAULT_PREVIEW_PORT=7456

# 9. Cấu hình Cloudflare Tunnel (Tự động tìm kiếm nếu để trống)
CLOUDFLARED_PATH=C:\Program Files (x86)\cloudflared\cloudflared.exe
CLOUDFLARE_MODE=quick
# CLOUDFLARE_TUNNEL_NAME=my-named-tunnel
# CLOUDFLARE_HOSTNAME=preview.yourdomain.com

# 10. Cấu hình Mạng & Proxy Telegram (Vượt tường lửa / Nhà mạng chặn api.telegram.org)
# Hỗ trợ HTTP Proxy (http://127.0.0.1:7890) hoặc SOCKS5 (socks5://127.0.0.1:10808)
# TELEGRAM_PROXY_URL=http://127.0.0.1:7890
# TELEGRAM_BASE_URL=https://your-telegram-proxy.workers.dev/bot
TELEGRAM_CONNECT_TIMEOUT=60.0
TELEGRAM_READ_TIMEOUT=60.0
TELEGRAM_WRITE_TIMEOUT=60.0

# 11. Cấu hình Thời gian chờ (Timeouts - Đơn vị: giây)
# Tác vụ AI Agent (Antigravity / Codex) - Mặc định 1800s (30 phút)
TASK_TIMEOUT=1800
# Lệnh Shell / Terminal (/cmd, /run) - Mặc định 300s (5 phút)
SHELL_TIMEOUT=300
# Khởi động Cocos Creator Preview - Mặc định 120s (2 phút)
COCOS_PREVIEW_TIMEOUT=120
# Tạo Cloudflare Quick Tunnel - Mặc định 60s (1 phút)
CLOUDFLARE_TUNNEL_TIMEOUT=60
