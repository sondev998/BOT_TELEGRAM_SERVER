# ==========================================
# CẤU HÌNH TELEGRAM BOT ĐIỀU KHIỂN ANTIGRAVITI
# ==========================================

# 1. Token Telegram Bot (Lấy từ @BotFather trên Telegram)
# Nhắn /newbot cho @BotFather để tạo bot và copy Token dán vào đây
TELEGRAM_BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN_HERE

# 2. Telegram User ID của bạn (Bảo mật: chỉ cho phép bạn điều khiển bot)
# Bạn có thể lấy User ID bằng cách chat với bot @userinfobot hoặc nhắn tin vào bot vừa tạo,
# bot sẽ tự báo ID của bạn nếu chưa được phân quyền.
# Có thể nhập nhiều ID cách nhau bằng dấu phẩy, ví dụ: 123456789,987654321
ALLOWED_USER_IDS=YOUR_TELEGRAM_USER_ID

# 3. Thư mục làm việc mặc định (Default Workspace)
DEFAULT_WORKSPACE=E:\TELEGRAM_BOT\GAME_DEV_BOT

# 4. Model Antigravity mặc định (Ví dụ: Gemini 3.7 Flash (High), Gemini 3.7 Pro, ...)
# Để trống để dùng model mặc định của Antigravity CLI
DEFAULT_MODEL=Gemini 3.7 Flash (High)

# 5. Reasoning Effort mặc định: low | medium | high
DEFAULT_EFFORT=high

# 6. Mode thực thi mặc định: accept-edits | plan
DEFAULT_MODE=accept-edits

# 7. Đường dẫn đến file thực thi agy (tự động phát hiện nếu để trống)
AGY_PATH=C:\Users\admin\AppData\Local\agy\bin\agy.exe

# 8. Thời gian timeout tối đa cho mỗi tác vụ (giây) - Mặc định 600s (10 phút)
TASK_TIMEOUT=600
